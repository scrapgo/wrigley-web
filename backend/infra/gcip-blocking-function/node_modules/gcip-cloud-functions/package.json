{
  "name": "gcip-cloud-functions",
  "version": "0.2.1",
  "description": "Google Cloud Identity Platform Blocking Functions for Node.js",
  "author": "Google",
  "license": "Apache-2.0",
  "homepage": "http://cloud.google.com/identity-platform/docs/blocking-functions",
  "engines": {
    "node": ">=10.0.0"
  },
  "scripts": {
    "build": "gulp build",
    "build-alpha": "./build-alpha.sh",
    "clean": "gulp cleanup",
    "deploy-functions": "./deploy.sh",
    "lint": "run-p lint:src lint:unit lint:integration lint:typings",
    "test": "run-s lint test:unit",
    "integration": "run-s build test:integration",
    "test:unit": "mocha test/unit/*.spec.ts --require ts-node/register",
    "test:integration": "npm run build && mocha test/integration/*.ts --slow 5000 --timeout 240000 --require ts-node/register",
    "test:e2e": "npm run deploy-functions && mocha test/integration/*.ts --slow 5000 --timeout 240000 --require ts-node/register",
    "test:coverage": "nyc npm run test:unit",
    "lint:src": "tslint --format stylish -p tsconfig.json",
    "lint:unit": "tslint -c tslint-test.json --format stylish test/unit/*.ts test/unit/**/*.ts",
    "lint:integration": "tslint -c tslint-test.json --format stylish test/integration/*.ts",
    "lint:typings": "tslint -c tslint-types.json --format stylish src/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GoogleCloudPlatform/iap-gcip-web-toolkit",
    "directory": "packages/gcip-cloud-functions"
  },
  "publishConfig": {
    "registry": "https://wombat-dressing-room.appspot.com"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "all": true
  },
  "keywords": [
    "cloud",
    "identity",
    "platform",
    "blocking",
    "gcip",
    "firebase",
    "functions",
    "authentication"
  ],
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "files": [
    "lib/",
    "sample/",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "types": "./lib/esm/index.d.ts",
  "dependencies": {
    "@types/cors": "^2.8.1",
    "@types/express": "^4.17.15",
    "@types/node": "^8.0.53",
    "cors": "^2.8.4",
    "express": "^4.18.2",
    "jsonwebtoken": "9.0.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@firebase/app": "^0.6.11",
    "@firebase/auth": "^0.14.9",
    "@types/chai": "^3.4.34",
    "@types/chai-as-promised": "0.0.29",
    "@types/lodash": "^4.14.178",
    "@types/mocha": "^8.2.0",
    "@types/nock": "^9.1.0",
    "@types/request": "^2.47.0",
    "@types/request-promise": "^4.1.41",
    "@types/sinon": "^4.1.3",
    "@types/sinon-chai": "2.7.27",
    "chai": "^4.3.4",
    "chai-as-promised": "^7.1.1",
    "chalk": "^5.0.0",
    "del": "6.0.0",
    "dtslint": "^4.2.1",
    "firebase-admin": "^9.1.0",
    "gulp": "^4.0.2",
    "gulp-exit": "0.0.2",
    "gulp-header": "^1.8.8",
    "gulp-istanbul": "^1.1.3",
    "gulp-replace": "^0.5.4",
    "gulp-tslint": "^8.1.4",
    "gulp-typescript": "^5.0.1",
    "lodash": "^4.17.21",
    "merge2": "^1.2.1",
    "minimist": "^1.2.8",
    "mocha": "^8.2.1",
    "nock": "^9.1.8",
    "npm-run-all": "^4.1.5",
    "nyc": "^14.1.1",
    "request": "^2.75.0",
    "request-promise": "^4.1.1",
    "sinon": "^4.4.5",
    "sinon-chai": "^2.8.0",
    "ts-node": "^3.3.0",
    "tslint": "^6.1.3",
    "typescript": "^4.9.4"
  }
}
