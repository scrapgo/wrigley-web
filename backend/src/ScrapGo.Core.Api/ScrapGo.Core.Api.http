# Requests against a locally running API (`dotnet run --project src/ScrapGo.Core.Api`).
# Paste a GCIP ID token for project wrigley-cloud-prod into @token.
@host = http://localhost:5141
@token = paste-a-gcip-id-token

### Health (anonymous)
GET {{host}}/healthz

### Start a session (creates an Internal user on a Workspace sign-in)
POST {{host}}/api/session
Authorization: Bearer {{token}}

### The caller: user, roles, permissions, features
GET {{host}}/api/me
Authorization: Bearer {{token}}

### Users (users.view)
GET {{host}}/api/admin/users?type=External&page=1&pageSize=25
Authorization: Bearer {{token}}

### Set a user's roles (users.manage; replaces the whole set)
PUT {{host}}/api/admin/users/1/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{ "roleIds": [2] }

### Invite an external user (users.invite; returns the accept link)
POST {{host}}/api/admin/invitations
Authorization: Bearer {{token}}
Content-Type: application/json

{ "email": "buyer@acme.example", "roleId": 3, "supplierRecordIds": [17511] }

### Roles and their permissions (roles.view)
GET {{host}}/api/admin/roles
Authorization: Bearer {{token}}

### Features (features.view)
GET {{host}}/api/admin/features
Authorization: Bearer {{token}}

### Audit log, newest first (audit.view)
GET {{host}}/api/admin/audit?action=user.disabled&page=1&pageSize=25
Authorization: Bearer {{token}}

### Permission catalog
GET {{host}}/api/admin/permissions
Authorization: Bearer {{token}}
