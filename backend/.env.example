# Every setting the API reads, as environment variables. Copy this file to
# .env.local (git-ignored) for `docker run --env-file .env.local`.
# `dotnet run` does NOT read .env files: it uses `dotnet user-secrets` (see
# AGENTS.md "Running Locally"). In Cloud Run these are set by
# infra/terraform, with secrets coming from Secret Manager.

ASPNETCORE_ENVIRONMENT=Development

# --- Required ---
# Cloud SQL through the Cloud SQL Auth Proxy running on your machine:
#   cloud-sql-proxy wrigley-cloud-prod:us-central1:<instance> --port 5434
# The proxy encrypts the connection to Cloud SQL, so the local hop needs no SSL.
# From inside a container, the host machine is host.docker.internal.
ConnectionStrings__Default=Host=host.docker.internal;Port=5434;Database=<database>;Username=<user>;Password=<password>;SSL Mode=Disable
# Google Cloud Identity Platform project whose ID tokens the API accepts.
Gcip__ProjectId=wrigley-cloud-prod

# --- Required on the first Quickbase call (validated on use, not at startup) ---
Quickbase__RealmHostname=
Quickbase__UserToken=

# --- Optional ---
# Gcip__JwksUri=
# INTERNAL_HD_ALLOWLIST=scrapgo.com
# Cors__AllowedOrigins__0=http://localhost:3000
# Quickbase__QueryCache__Ttl=00:15:00
# Quickbase__QueryCache__ServeStaleOnError=true
# Quickbase__Timeout=00:00:30
# Quickbase__MaxRetryAttempts=3
# Quickbase__RetryBaseDelay=00:00:01
# Swagger__Enabled=true
# PORT=8080
