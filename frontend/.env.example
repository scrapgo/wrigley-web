# ScrapGo Portal Web — environment configuration
#
# Copy to `.env.local` (gitignored) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Base URL of the ScrapGo.Core.Api backend.
# Leave EMPTY in development to use the Vite dev proxy (see vite.config.ts),
# which forwards /api to http://localhost:5141 and avoids CORS entirely.
# In production set this to the deployed API origin, e.g. https://api.scrapgo.com
VITE_API_BASE_URL=

# Google Cloud Identity Platform (GCIP) web API key.
# This is a PUBLIC client key (safe to ship in the browser bundle) — it is not
# a secret. It is used only for the signInWithPassword REST call.
VITE_GCIP_API_KEY=

# OAuth 2.0 web client id of the Google provider enabled in GCIP
# (Identity Platform > Providers > Google > Web SDK configuration). Public.
# Blank hides the "Sign in with Google" button. Platform administrators must
# sign in with Google (their Workspace account): the API requires the token's
# hd claim, which only a Google sign-in carries.
VITE_GOOGLE_CLIENT_ID=

# Optional Workspace domain hint for Google's account chooser (e.g. scrapgo.com).
# UX only; it also hides non-Workspace accounts, so leave blank if external
# users sign in with Google too. The API enforces the domain, not this.
VITE_GOOGLE_HOSTED_DOMAIN=

# GCIP project id (used for display/diagnostics only).
VITE_GCIP_PROJECT_ID=wrigley-cloud-prod
